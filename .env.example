# Database
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian

# Ports
API_PORT=4000
WEB_PORT=5173

# Crawler identity (sites see this; use a real contact address)
CRAWLER_USER_AGENT=MeridianBot/0.1 (+https://zenostudio.example/bot; contact: you@zenostudio.example)

# Politeness and resource limits (tune after benchmarking)
WORKER_CONCURRENCY=2
DOMAIN_MIN_DELAY_MS=2000
REQUEST_TIMEOUT_MS=15000
PLAYWRIGHT_MAX_CONTEXTS=1

# Discovery providers
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

NODE_ENV=development
LOG_LEVEL=info