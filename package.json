{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Business intelligence, website investigation and prospecting platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @meridian/db db:generate",
    "db:migrate": "pnpm --filter @meridian/db db:migrate",
    "db:seed": "pnpm --filter @meridian/db db:seed",
    "db:studio": "pnpm --filter @meridian/db db:studio"
  }
}